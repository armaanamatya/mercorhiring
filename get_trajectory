#!/usr/bin/env python3
"""Extract one trajectory from the local archive.

Usage:  python3 get_trajectory <run_id> <task_id>
        python3 get_trajectory --list-runs
"""
import csv, io, json, os, sys

HERE = os.path.dirname(os.path.abspath(__file__))
INDEX = os.path.join(HERE, "trajectories", "trajectory_index.csv")
ARCHIVE = os.path.join(HERE, "trajectories", "archive.jsonl.zst")


def load_index():
    with open(INDEX) as fh:
        return list(csv.DictReader(fh))


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "--list-runs":
        print("\n".join(sorted({r["run_id"] for r in load_index()})))
        return 0
    if len(sys.argv) != 3:
        print(__doc__.strip())
        return 2
    run_id, task_id = sys.argv[1], sys.argv[2]
    rows = [r for r in load_index()
            if r["run_id"] == run_id and r["task_id"] == task_id]
    if not rows:
        print(f"no trajectory for {run_id} / {task_id}. "
              f"Some runs have no recorded calls; see runs.csv.", file=sys.stderr)
        return 1
    try:
        import zstandard
    except ImportError:
        print("this utility needs the 'zstandard' package: pip install zstandard",
              file=sys.stderr)
        return 3
    want = int(rows[0]["record_index"])
    with open(ARCHIVE, "rb") as fh:
        data = zstandard.ZstdDecompressor().decompress(fh.read())
    for i, line in enumerate(io.BytesIO(data)):
        if i == want:
            print(json.dumps(json.loads(line), indent=2))
            return 0
    print("record not found in archive", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
